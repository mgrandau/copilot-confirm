{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Install Local",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/copilot-confirm",
            "args": ["--local"],
            "group": "build",
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "Install Global",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/copilot-confirm",
